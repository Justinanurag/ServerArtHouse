# Customer portal auth — optional overrides (falls back to JWT_SECRET)
CUSTOMER_JWT_ACCESS_SECRET=
CUSTOMER_JWT_REFRESH_SECRET=
CUSTOMER_ACCESS_TOKEN_TTL=15m
CUSTOMER_REFRESH_TOKEN_DAYS=30
CUSTOMER_OTP_AUTO_CREATE=true
# Set true only for local debugging (never in production)
CUSTOMER_OTP_DEBUG=false

# WhatsApp Meta Cloud API
# Phone Number ID = ID under "From" on App Dashboard → WhatsApp → API Setup
# Do NOT use WhatsApp Business Account ID (WABA) here — that causes Graph error 100/33
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token (Admin) with:
#   whatsapp_business_messaging, whatsapp_business_management
# Assign the System User to the WABA under Business Settings → WhatsApp Accounts
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=woowoootp
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v21.0

# Membership activation WhatsApp template (Customer portal: membershippurchase)
WHATSAPP_MEMBERSHIP_TEMPLATE=membershippurchase
WHATSAPP_NEW_MEMBERSHIP_TEMPLATE=membershippurchase
WHATSAPP_MEMBERSHIP_TEMPLATE_LANGUAGE=en_US
# Optional: dynamic suffixes for URL buttons (leave empty if URLs are static)
WHATSAPP_MEMBERSHIP_VIEW_URL_PARAM=
WHATSAPP_MEMBERSHIP_APP_URL_PARAM=
WHATSAPP_NEW_MEMBERSHIP_PROSITE_URL_PARAM=
WHATSAPP_NEW_MEMBERSHIP_APP_URL_PARAM=
# Welcome cashback credited on activation (shown as ₹50)
WHATSAPP_MEMBERSHIP_CASHBACK=50

# Membership upgrade WhatsApp template (Meta: membershipchange)
# Body (typical): {{1}} name, {{2}} plan, {{3}} validity, {{4}} cashback digits (template has ₹)
# Button: Visit Membership (optional dynamic URL suffix)
WHATSAPP_MEMBERSHIP_CHANGE_TEMPLATE=membershipchange
WHATSAPP_MEMBERSHIP_CHANGE_TEMPLATE_LANGUAGE=en_US
WHATSAPP_MEMBERSHIP_CHANGE_URL_PARAM=
WHATSAPP_COMPANY_NAME=WOOWOO Art House

# Account created WhatsApp template (Customer portal: accountcreated)
WHATSAPP_ACCOUNT_CREATED_TEMPLATE=accountcreated
WHATSAPP_NEW_ACCOUNT_TEMPLATE=accountcreated
WHATSAPP_ACCOUNT_CREATED_TEMPLATE_LANGUAGE=en_US
# Optional: dynamic URL button suffixes for Check Balance / View Prosite
WHATSAPP_ACCOUNT_CREATED_BALANCE_URL_PARAM=
WHATSAPP_ACCOUNT_CREATED_PROSITE_URL_PARAM=
WHATSAPP_NEW_ACCOUNT_PROFILE_URL_PARAM=
WHATSAPP_NEW_ACCOUNT_APP_URL_PARAM=
# Welcome cashback on account create (shown as ₹25)
WHATSAPP_ACCOUNT_CREATED_CASHBACK=25

# Invoice / bill Activity Update WhatsApp template
WHATSAPP_ACTIVITY_UPDATE_TEMPLATE=activityupdate
WHATSAPP_ACTIVITY_UPDATE_TEMPLATE_LANGUAGE=en
# Optional: dynamic URL button suffixes for Check details / View wallet
WHATSAPP_ACTIVITY_DETAILS_URL_PARAM=
WHATSAPP_ACTIVITY_WALLET_URL_PARAM=
# Meta body is "As a {{6}} Member" → we send "Premium" (default).
# Set to 1 only if Meta text is "As a {{6}}," without the word Member.
WHATSAPP_ACTIVITY_MEMBERSHIP_FULL_LABEL=

# Membership renewal reminder (Meta template: membershiprenewal)
# Body: {{1}} name, {{2}} days, {{3}} savings digits only (template has ₹), {{4}} plan, {{5}} cashback digits only
WHATSAPP_MEMBERSHIP_RENEWAL_TEMPLATE=membershiprenewal
WHATSAPP_MEMBERSHIP_RENEWAL_TEMPLATE_LANGUAGE=en
WHATSAPP_MEMBERSHIP_RENEWAL_URL_PARAM=
WHATSAPP_MEMBERSHIP_RENEWAL_CASHBACK=200
WHATSAPP_MEMBERSHIP_RENEWAL_SOON_DAYS=30

# ---------- Razorpay (membership checkout) ----------
# Dashboard → Settings → API Keys → Generate Test/Live Key
# Key ID is public (safe to expose to frontend)
# Key Secret is private (server-only, never send to browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- PayU (membership checkout — legacy, now replaced by Razorpay) ----------
# Dashboard → toggle Test/Live Mode → Developers → API Keys
# Use MATCHING mode credentials:
#   PAYU_MODE=TEST  → Test key + Test Salt-32bit  → test.payu.in
#   PAYU_MODE=LIVE  → Live key + Live Salt-32bit  → secure.payu.in
# Salt-32bit only (NOT an RSA private key)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_MODE=LIVE
# Must be public HTTPS URLs in LIVE (PayU cannot reach localhost)
# API public URL (PayU surl/furl). Example: https://woo-woo-erp.vercel.app
SERVER_PUBLIC_URL=https://woo-woo-erp.vercel.app
# Customer portal main domain
CUSTOMER_APP_URL=https://woowooarthouse.in
# Admin ERP subdomain
CLIENT_APP_URL=https://admin.woowooarthouse.in
